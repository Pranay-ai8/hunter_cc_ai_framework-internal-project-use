{
  "name": "wdio-native-demo-app-webdriverio-js",
  "version": "1.0.0",
  "description": "WebdriverIO + JavaScript + Appium + Cucumber mobile automation for the WebdriverIO Native Demo App (Android) — sibling framework to the Appium-Java stack in ../Framework.",
  "type": "module",
  "scripts": {
    "wdio": "wdio run ./wdio.conf.js",
    "wdio:smoke": "wdio run ./wdio.conf.js --cucumberOpts.tags=@smoke",
    "wdio:regression": "wdio run ./wdio.conf.js --cucumberOpts.tags=@regression",
    "wdio:ios": "RUN_ON=iOS_APP wdio run ./wdio.conf.js",
    "wdio:ios:smoke": "RUN_ON=iOS_APP wdio run ./wdio.conf.js --cucumberOpts.tags=@smoke",
    "wdio:ios:regression": "RUN_ON=iOS_APP wdio run ./wdio.conf.js --cucumberOpts.tags=@regression",
    "test": "node --max-old-space-size=4096 ./node_modules/.bin/wdio run ./wdio.conf.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "10.9.0",
    "@wdio/allure-reporter": "9.31.1",
    "@wdio/appium-service": "9.31.1",
    "@wdio/cli": "9.31.1",
    "@wdio/cucumber-framework": "9.31.1",
    "@wdio/globals": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/spec-reporter": "9.31.1",
    "allure-commandline": "2.43.0",
    "appium": "3.6.0",
    "appium-uiautomator2-driver": "8.4.0"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  }
}
