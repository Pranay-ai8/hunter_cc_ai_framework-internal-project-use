{
  "name": "saucedemo-cypress-automation",
  "version": "1.0.0",
  "description": "Cypress + plain JavaScript (ES Modules) automation suite for SauceDemo (https://www.saucedemo.com/)",
  "type": "module",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:smoke": "cypress run --spec \"cypress/e2e/smokeSuites/**/*.cy.js\" --env grepTags=@smoke",
    "test:regression": "cypress run --spec \"cypress/e2e/regressionSuites/**/*.cy.js\" --env grepTags=@regression",
    "test:regression:desktop": "cypress run --spec \"cypress/e2e/regressionSuites/desktop/**/*.cy.js\" --env grepTags=@regression",
    "test:manual": "cypress run --spec \"cypress/e2e/regressionSuites/**/*.cy.js\" --env grepTags=@manual",
    "test:sanity": "cypress run --env grepTags=@sanity",
    "report:merge": "mochawesome-merge cypress/reports/mochawesome/*.json > cypress/reports/mochawesome/report.json",
    "report:generate": "marge cypress/reports/mochawesome/report.json -f report -o cypress/reports/mochawesome"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "@cypress/grep": "^4.1.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}
