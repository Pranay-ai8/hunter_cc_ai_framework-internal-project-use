<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Automation Suite" parallel="tests" thread-count="2">

  <listeners>
    <listener class-name="com.codecraft.saucedemo.listeners.WebAnnotationTransformer"/>
    <listener class-name="com.codecraft.saucedemo.listeners.TestListener"/>
    <listener class-name="com.codecraft.saucedemo.listeners.WebListener"/>
    <listener class-name="com.codecraft.saucedemo.listeners.WebEmailReport"/>
  </listeners>

  <parameter name="env" value="prod"/>
  <parameter name="username" value="standard_user"/>
  <parameter name="password" value="secret_sauce"/>

  <test name="Authentication Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.login.LoginTest"/>
    </classes>
  </test>

  <test name="Product Catalog Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.inventory.InventoryTest"/>
    </classes>
  </test>

  <test name="Product Detail Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.productdetail.ProductDetailTest"/>
    </classes>
  </test>

  <test name="Cart Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.cart.CartTest"/>
    </classes>
  </test>

  <test name="Checkout Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.checkout.CheckoutTest"/>
    </classes>
  </test>

  <test name="Order Confirmation Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.orderconfirmation.OrderConfirmationTest"/>
    </classes>
  </test>

  <test name="Navigation Menu Tests">
    <classes>
      <class name="com.codecraft.saucedemo.tests.menu.MenuTest"/>
    </classes>
  </test>

</suite>
