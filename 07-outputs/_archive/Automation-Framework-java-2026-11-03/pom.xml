<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.cresanmanagement.eyeq</groupId>
    <artifactId>eyeq-appium-automation</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>EyeQ Monitoring - Appium Automation Framework</name>
    <description>
        Appium + Java + TestNG + Maven automation framework for the EyeQ Monitoring Android app
        (com.cresanmanagement.eyeq). Scaffolded by 05-agents/automation-framework-appium-java-agent.md.
        Android-only / NATIVE context. BrowserStack remote execution was declined for this project, so no
        BrowserStack profiles, device_conf.json, or uploader classes are included.
    </description>

    <properties>
        <!-- ========================================================================================
             Dependency Version Policy (see 03-standards/appium-java-standards.md): every version below
             was individually re-verified against Maven Central's maven-metadata.xml on 2026-10-16 at
             generation time. Do not copy these numbers into a future scaffold without re-verifying again.
             ======================================================================================== -->
        <defaultSuiteFiles>src/test/java/com/cresanmanagement/eyeq/CC_TestNG.xml</defaultSuiteFiles>
        <suiteFile>${defaultSuiteFiles}</suiteFile>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>

        <extentreports.version>5.1.2</extentreports.version>
        <testng.version>7.12.0</testng.version>
        <java.client.appium>11.0.0</java.client.appium>
        <!-- FLOOR of io.appium:java-client:11.0.0's own declared Selenium range [4.50.0, 5.0) -
             verified via the Gradle module metadata (java-client-11.0.0.module): "prefers": "4.50.0".
             See the Selenium Version Pin section below - this is the mandatory pin, not a placeholder. -->
        <selenium.version>4.50.0</selenium.version>
        <log4j.version>2.26.1</log4j.version>
        <javassist.version>3.33.0-GA</javassist.version>
        <!-- Pinned to the latest 4.x release, not the newest overall (5.5.0): okhttp 5.x's plain
             "okhttp" Maven Central artifact is now a Kotlin-Multiplatform metadata-only jar with zero
             JVM classes (verified by downloading and inspecting it during this generation) - a plain
             Maven/non-KMP-aware consumer like this project cannot use it directly. 4.12.0 is still a
             normal JVM jar and is the newest version in that state. -->
        <okhttp.version>4.12.0</okhttp.version>
        <commons.collections4.version>4.6.0</commons.collections4.version>
        <json.simple.version>1.1.1</json.simple.version>

        <maven.compiler.plugin.version>3.16.0</maven.compiler.plugin.version>
        <!-- NOT the newest overall (3.6.0) - verified live during this generation that 3.6.0 dropped
             the classic native TestNG provider (org.apache.maven.surefire:surefire-testng was never
             released for 3.6.0 - 3.5.6 is its last release) in favor of auto-detecting a JUnit-Platform
             + "org.junit.support:testng-engine" adapter instead, which (a) needs that adapter artifact
             downloaded from the network - unusable in an offline/air-gapped CI build - and (b) prints
             "'suiteXmlFiles' ... deprecated: not supported after 3.6.0", i.e. it no longer honors
             CC_TestNG.xml/CC_Sample_TestNG.xml the way this stack's whole suite-file convention
             requires. 3.5.6 is the newest version that still works with this project's TestNG suite-XML
             setup out of the box. -->
        <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    </properties>

    <!-- ============================================================================================
         Maven Profiles - Android ONLY for this project (user-confirmed platform scope: "Android only").
         The iOS / bsAndroid / bsiOS profiles from 02-templates/AppiumFramework.md are intentionally
         NOT generated here: this project is Android-only and BrowserStack remote execution was
         explicitly declined, so those profiles would configure a setup this project never exercises -
         the same "don't scaffold what nothing asks for" rule applied to credentials.properties /
         device_conf.json elsewhere in 03-standards/appium-java-standards.md. Add them later, specifically,
         if iOS or BrowserStack support is ever requested.
         ============================================================================================ -->
    <profiles>
        <profile>
            <id>android</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <RunOn.value>ANDROID_APP</RunOn.value>
                <Context.value>NATIVE</Context.value>
                <Setup.value>Local</Setup.value>
            </properties>
        </profile>
    </profiles>

    <!-- ============================================================================================
         Selenium Version Pin (MANDATORY - see 03-standards/appium-java-standards.md's
         "Dependency Version Policy" section).

         Live investigation performed during this generation (java-client-11.0.0.pom /
         java-client-11.0.0.module from Maven Central) found that java-client 11.0.0 only declares ONE
         direct Selenium dependency - selenium-api, as the open-ended range [4.50.0, 5.0) - it no longer
         pulls selenium-remote-driver/-support/-http/-json/-manager/-os transitively at all (Appium's
         java-client has decoupled from Selenium's RemoteWebDriver class hierarchy in recent major
         versions; AndroidDriver/AppiumDriver no longer extend it, and TouchAction has been removed in
         favor of the W3C Actions/PointerInput API, which lives in selenium-api itself).

         All seven artifacts are still pinned here exactly as the standard mandates (pinning only some
         of seven would be the same partial-pin risk the standard warns about if a future java-client
         release or any other dependency ever reintroduces one of them transitively) - but only
         selenium-api and selenium-support are declared as actual <dependency> entries below, because
         selenium-support (WebDriverWait, PageFactory, ExpectedConditions, FieldDecorator) IS required by
         this framework's own code (Base.java, Object_Base.java) and is NOT pulled in by java-client
         11.0.0 transitively - it must be declared explicitly.
         ============================================================================================ -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-api</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-remote-driver</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-support</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-http</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-json</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-manager</artifactId>
                <version>${selenium.version}</version>
            </dependency>
            <dependency>
                <groupId>org.seleniumhq.selenium</groupId>
                <artifactId>selenium-os</artifactId>
                <version>${selenium.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Appium - brings selenium-api transitively, pinned to the dependencyManagement block above
             via its own declared range. Do NOT also declare selenium-java (see Dependency Version
             Policy above for why: it pulls unrelated desktop browser drivers and its own
             independently-versioned selenium-api/-support, which would conflict with this pin). -->
        <dependency>
            <groupId>io.appium</groupId>
            <artifactId>java-client</artifactId>
            <version>${java.client.appium}</version>
        </dependency>

        <!-- Explicit - NOT pulled transitively by java-client 11.0.0 (see note above).
             Provides WebDriverWait, PageFactory, ExpectedConditions, FieldDecorator. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
        </dependency>

        <!-- TestNG -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- Reporting: ExtentReports -->
        <dependency>
            <groupId>com.aventstack</groupId>
            <artifactId>extentreports</artifactId>
            <version>${extentreports.version}</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${log4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j.version}</version>
        </dependency>

        <!-- JSON (ReadJson.java). Excludes its transitive junit:junit:4.10 - live-run correction:
             that old JUnit 4.x jar on the classpath made maven-surefire-plugin 3.6.0's provider
             auto-detection pick the JUnit Platform provider instead of TestNG, which then failed
             outright ("Surefire is not compatible with JUnit 4.11 or older") before a single test
             could run. json-simple only uses junit for its own test suite, never at runtime. -->
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>${json.simple.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>junit</groupId>
                    <artifactId>junit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- HTTP (APIBase.java) -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
            <version>${okhttp.version}</version>
        </dependency>

        <!-- Utilities (ReusuableUtility.java / Stream.java) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons.collections4.version}</version>
        </dependency>

        <!-- Javassist (TestNG PriorityInterceptor - line-number based test ordering) -->
        <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>${javassist.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>eyeq-appium-automation</finalName>
        <!-- Resource filtering is REQUIRED: config.properties' RUN_ON/CONTEXT/SETUP values use
             ${RunOn.value}/${Context.value}/${Setup.value} placeholders that only the active Maven
             profile (see Profiles above) supplies - without filtering enabled here, those placeholders
             are copied into target/classes/config.properties verbatim instead of being substituted,
             and InitiateDriver fails fast with "Unsupported RUN_ON '${RunOn.value}'" (confirmed via a
             live throwaway driver-construction smoke test during this generation - see
             03-standards/appium-java-standards.md's Dependency Version Policy step 4, which this
             filtering fix was discovered while satisfying). -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven.compiler.plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.surefire.plugin.version}</version>
                <!-- Pin the classic native TestNG provider explicitly rather than relying on
                     auto-detection - verified live that auto-detection is not reliable on this
                     classpath (it picked the JUnit Platform provider over TestNG at least once during
                     this generation, failing the build before a single test could run). -->
                <dependencies>
                    <dependency>
                        <groupId>org.apache.maven.surefire</groupId>
                        <artifactId>surefire-testng</artifactId>
                        <version>${maven.surefire.plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <skipTests>${skipTests}</skipTests>
                    <systemPropertyVariables>
                        <device>${RunOn.value}</device>
                        <env>${env}</env>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
