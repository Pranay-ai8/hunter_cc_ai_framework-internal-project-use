<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">
<!--
    Scoped regression run for the Virtual Guard module only - created 2026-10-26 to validate the live-crawl
    fixes (Guarding Stats title case, KPI value extraction, Activity Log xpath, Schedule sheet open/close +
    lightReset cleanup, Forensic Clips site gating, ensureSiteSelected short-circuit). Sequential, single
    <test>, same shared-session architecture as CC_TestNG.xml.
-->
<suite name="VirtualGuardRegressionSuite" verbose="2">
    <listeners>
        <listener class-name="com.cresanmanagement.eyeq.testng.SuiteCreationListener"/>
        <listener class-name="com.cresanmanagement.eyeq.testng.TestListener"/>
        <listener class-name="com.cresanmanagement.eyeq.testng.MobileEmailReport"/>
    </listeners>

    <test name="VirtualGuardTests" preserve-order="true">
        <classes>
            <class name="com.cresanmanagement.eyeq.virtualguardtests.VirtualGuardTests"/>
        </classes>
    </test>
</suite>
