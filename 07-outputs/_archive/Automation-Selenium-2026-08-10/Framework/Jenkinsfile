pipeline {
    agent any

    parameters {
        choice(name: 'ENV', choices: ['prd'], description: 'Target environment (SauceDemo has one live environment)')
        choice(name: 'BROWSER', choices: ['chrome', 'firefox', 'edge'], description: 'Browser to run against')
        choice(name: 'SUITE', choices: ['config/testng_config.xml', 'config/testng_smoke.xml', 'config/testng_regression.xml'], description: 'TestNG suite file')
    }

    tools {
        jdk 'JDK17'
        maven 'Maven3'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('07-outputs/Automation-Selenium/Framework') {
                    sh 'mvn -B clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('07-outputs/Automation-Selenium/Framework') {
                    sh "mvn -B clean test -Dsurefire.suiteXmlFiles=${params.SUITE} -Denv=${params.ENV} -Dbrowser=${params.BROWSER}"
                }
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: '07-outputs/Automation-Selenium/Framework/target/surefire-reports/*.xml'
            archiveArtifacts artifacts: '07-outputs/Automation-Selenium/Framework/test-output/**', allowEmptyArchive: true
        }
    }
}
