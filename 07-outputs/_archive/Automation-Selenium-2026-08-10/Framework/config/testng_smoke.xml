<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Selenium Smoke Suite" parallel="methods" thread-count="4">

  <listeners>
    <listener class-name="com.codecraft.saucedemo.listeners.AnnotationTransformer"/>
    <listener class-name="com.codecraft.saucedemo.listeners.TestListener"/>
  </listeners>

  <parameter name="env" value="prd"/>

  <test name="Smoke Suite">
    <groups>
      <run>
        <include name="smoke"/>
      </run>
    </groups>
    <classes>
      <class name="com.codecraft.saucedemo.tests.login.LoginTest"/>
      <class name="com.codecraft.saucedemo.tests.inventory.InventoryTest"/>
      <class name="com.codecraft.saucedemo.tests.productdetail.ProductDetailTest"/>
      <class name="com.codecraft.saucedemo.tests.cart.CartTest"/>
      <class name="com.codecraft.saucedemo.tests.checkout.CheckoutTest"/>
      <class name="com.codecraft.saucedemo.tests.orderconfirmation.OrderConfirmationTest"/>
      <class name="com.codecraft.saucedemo.tests.menu.MenuTest"/>
    </classes>
  </test>

</suite>
