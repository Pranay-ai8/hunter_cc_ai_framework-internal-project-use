{
  "name": "saucedemo-playwright-js-cucumber",
  "version": "1.0.0",
  "description": "Playwright + plain JavaScript + Cucumber (BDD) automation suite for SauceDemo (https://www.saucedemo.com/)",
  "private": true,
  "scripts": {
    "pretest": "node src/helper/report/init.js",
    "test": "cucumber-js --config=config/cucumber.js",
    "posttest": "node src/helper/report/report.js",
    "test:failed": "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js -p rerun @rerun.txt",
    "test:smoke": "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @smoke",
    "test:regression": "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @regression",
    "test:sanity": "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @sanity",
    "test:partial": "cross-env ENV=PRD node src/helper/report/runCucumberWithReport.js --config=config/cucumber.js --tags @partial",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.49.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.10.2",
    "allure-js-commons": "^2.15.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "fs-extra": "^11.1.1",
    "multiple-cucumber-html-reporter": "^3.3.0",
    "winston": "^3.8.2"
  },
  "dependencies": {
    "csv-parse": "^6.1.0"
  }
}
